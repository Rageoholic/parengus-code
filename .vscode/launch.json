{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(Windows) Launch phoenix",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/phoenix/debug/phoenix.exe",
            "args": [
                "--tracing-log-level",
                "warn",
                "--graphics-debug-level",
                "warn"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}/out/phoenix/debug/",
            "environment": [
                {
                    "name": "RUST_BACKTRACE",
                    "value": "1"
                }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "build phoenix debug"
        }
    ]
}